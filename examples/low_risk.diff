diff --git a/shop/pricing.py b/shop/pricing.py
index 3b18e51..a9c2f7d 100644
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,6 +1,11 @@
 from decimal import Decimal
 
 
 def apply_discount(price: Decimal, percent: int) -> Decimal:
     """Return the price after applying a percentage discount."""
     return price * (Decimal(100) - percent) / Decimal(100)
+
+
+def format_price(price: Decimal, currency: str = "USD") -> str:
+    """Format a price for display, e.g. '12.50 USD'."""
+    return f"{price.quantize(Decimal('0.01'))} {currency}"
